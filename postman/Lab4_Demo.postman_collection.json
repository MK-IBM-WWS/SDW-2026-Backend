          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Updated fields\", function () { const d=pm.response.json().data; pm.expect(d.price_per_month).to.eql(1500); pm.expect(d.ram_gb).to.eql(16); pm.expect(d.tariff_status).to.eql(\"опубликован\"); });"
                ]
              }
            }
          ]
        },
